{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "pnpm install --frozen-lockfile && pnpm --filter @lg/merchant-api... build"
  },
  "deploy": {
    "startCommand": "pnpm --filter @lg/merchant-api start:railway",
    "restartPolicyType": "ON_FAILURE",
    "healthcheckPath": "/health"
  }
}